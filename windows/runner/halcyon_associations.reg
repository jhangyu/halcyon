Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\Halcyon.Photo]
@="Halcyon Photo"

[HKEY_CURRENT_USER\Software\Classes\Halcyon.Photo\shell\open\command]
@="\"%LOCALAPPDATA%\Halcyon\halcyon.exe\" \"%1\""

